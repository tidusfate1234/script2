		vulnLabel.Position = UDim2.new(0, 30, 0, yOffset)
		vulnLabel.BackgroundTransparency = 1
		vulnLabel.Text = "[" .. vuln.risk .. "] " .. vuln.reason
		vulnLabel.TextColor3 = vulnColor
		vulnLabel.TextTransparency = 0.2
		vulnLabel.TextSize = 9
		vulnLabel.TextXAlignment = Enum.TextXAlignment.Left
		vulnLabel.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
		vulnLabel.TextTruncate = Enum.TextTruncate.AtEnd
		vulnLabel.Parent = entry
		yOffset += 13
