	nameLabel.Size = UDim2.new(1, -80, 0, 20)
	nameLabel.Position = UDim2.new(0, 22, 0, 2)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = classPrefix .. name
	nameLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
	nameLabel.TextSize = 13
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
	nameLabel.Parent = entry
	local pathLabel = Instance.new("TextLabel")
	pathLabel.Size = UDim2.new(1, -80, 0, 14)
	pathLabel.Position = UDim2.new(0, 22, 0, 20)
	pathLabel.BackgroundTransparency = 1
	pathLabel.Text = path
	pathLabel.TextColor3 = Color3.fromRGB(90, 90, 110)
	pathLabel.TextSize = 10
	pathLabel.TextXAlignment = Enum.TextXAlignment.Left
	pathLabel.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	pathLabel.TextTruncate = Enum.TextTruncate.AtEnd
	pathLabel.Parent = entry
	local reasonLabel = Instance.new("TextLabel")
	reasonLabel.Size = UDim2.new(1, -80, 0, 14)
	reasonLabel.Position = UDim2.new(0, 22, 0, 34)
	reasonLabel.BackgroundTransparency = 1
	reasonLabel.Text = "\226\134\146 " .. reason
	reasonLabel.TextColor3 = riskColor
	reasonLabel.TextTransparency = 0.3
	reasonLabel.TextSize = 10
	reasonLabel.TextXAlignment = Enum.TextXAlignment.Left
	reasonLabel.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	reasonLabel.Parent = entry
	local yOffset = 48
	for _, meta in metaLines do
		local metaLabel = Instance.new("TextLabel")
		metaLabel.Size = UDim2.new(1, -80, 0, 13)
		metaLabel.Position = UDim2.new(0, 30, 0, yOffset)
		metaLabel.BackgroundTransparency = 1
		metaLabel.Text = meta
		metaLabel.TextColor3 = Color3.fromRGB(130, 130, 155)
		metaLabel.TextSize = 9
		metaLabel.TextXAlignment = Enum.TextXAlignment.Left
		metaLabel.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
		metaLabel.TextTruncate = Enum.TextTruncate.AtEnd
		metaLabel.Parent = entry
		yOffset += 13
	end
	for _, vuln in vulnList do
		local vulnColor = COLOR[vuln.risk] or COLOR.LOW
