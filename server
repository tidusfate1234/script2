	local riskBadge = Instance.new("TextLabel")
	riskBadge.Size = UDim2.new(0, 55, 0, 18)
	riskBadge.Position = UDim2.new(1, -62, 0, 4)
	riskBadge.BackgroundColor3 = riskColor
	riskBadge.BackgroundTransparency = 0.7
	riskBadge.Text = riskLevel
	riskBadge.TextColor3 = riskColor
	riskBadge.TextSize = 10
	riskBadge.FontFace = Font.new("rbxasset://fonts/families/Inconsolata.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
	riskBadge.BorderSizePixel = 0
	Instance.new("UICorner", riskBadge).CornerRadius = UDim.new(0, 3)
	riskBadge.Parent = entry
	local clickDetector = Instance.new("TextButton")
	clickDetector.Size = UDim2.new(1, 0, 1, 0)
	clickDetector.BackgroundTransparency = 1
	clickDetector.Text = ""
	clickDetector.Parent = entry
	clickDetector.MouseButton1Click:Connect(function()
		if className == "RemoteEvent" or className == "RemoteFunction" then
			local fullPath = path:gsub("^game%.", "")
			local exploitCode = ""
			if className == "RemoteEvent" then
				exploitCode = "game." .. fullPath .. ":FireServer()"
			elseif className == "RemoteFunction" then
				exploitCode = "local result = game." .. fullPath .. ":InvokeServer()\nprint(result)"
			end
			setTarget(name, className, riskColor)
			if typer then
				typer.Text = exploitCode
				updateLineNumbers()
				if syntaxDisplay then
					syntaxDisplay.Text = typer.Text
				end
			end
			if tabs[activeTabIndex] then
				tabs[activeTabIndex].content = exploitCode
			end
		elseif className == "Player" then
			setTarget(name, className, COLOR.PLAYER)
			if typer then
				typer.Text = "-- Target: " .. name .. "\nlocal target = game.Players:FindFirstChild(\"" .. name .. "\")"
				updateLineNumbers()
				if syntaxDisplay then
					syntaxDisplay.Text = typer.Text
				end
			end
			if tabs[activeTabIndex] then
				tabs[activeTabIndex].content = typer.Text
			end
		end
	end)
	clickDetector.MouseEnter:Connect(function()
		TweenService:Create(entry, TweenInfo.new(0.1), {
			BackgroundColor3 = Color3.fromRGB(25, 25, 35)
		}):Play()
	end)
	clickDetector.MouseLeave:Connect(function()
		TweenService:Create(entry, TweenInfo.new(0.1), {
			BackgroundColor3 = Color3.fromRGB(15, 15, 22)
		}):Play()
	end)
	entry.Parent = resultsList
end

local scanDebounce = false

local function runScan()
	if isScanning or scanDebounce then return end
	scanDebounce = true
	isScanning = true
	scanner.Visible = true
	if mainContent then mainContent.Visible = false end
	if savedPanel then savedPanel.Visible = false end
	clearResults()
	statusLabel.Text = "Scanning..."
	statusLabel.TextColor3 = COLOR.INFO
	local remotesFound = 0
	local scriptsFound = 0
	local playersFound = 0
	local vulnCount = 0
	local highCount = 0

	local remoteEntries = {}
	local scriptEntries = {}
	local partEntries = {}
	local playerEntries = {}
	local gMetaEntries = {}

	local function cleanupScan()
		isScanning = false
		scanDebounce = false
	end

	local success, err = pcall(function()
		statusLabel.Text = "Scanning remotes..."
		for _, target in SCAN_TARGETS do
			if target then
				local ok, descendants = pcall(function() return target:GetDescendants() end)
				if ok then
					for _, desc in descendants do
						if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") then
							remotesFound += 1
							local result = assessRemoteRisk(desc)
							if result.risk == "HIGH" then highCount += 1 end
							vulnCount += #result.metadata
							table.insert(remoteEntries, {
								name = desc.Name,
								className = desc.ClassName,
								path = safeGetFullName(desc),
								risk = result.risk,
								reason = result.reason,
								metadata = result.metadata,
							})
						end
					end
				end
			end
		end
		task.wait()

		statusLabel.Text = "Scanning scripts..."
		local scriptTargets = {
			game:GetService("StarterGui"),
			game:GetService("StarterPlayer"),
			game:GetService("StarterPack"),
			game:GetService("ReplicatedStorage"),
			workspace,
		}
		for _, target in scriptTargets do
			if target then
				local ok, descendants = pcall(function() return target:GetDescendants() end)
				if ok then
					for _, desc in descendants do
						if desc:IsA("LocalScript") or desc:IsA("ModuleScript") then
							scriptsFound += 1
							local sourceOk, source = pcall(function() return desc.Source end)
							local scriptRisk = "LOW"
							local scriptReason = "client script"
							local scriptMeta = {}
							local scriptVulns = {}
							if sourceOk and source and #source > 0 then
								local scanResult = scanScriptSource(source)
								if scanResult.score >= 5 then
									scriptRisk = "HIGH"
									scriptReason = "critical vulnerabilities (score: " .. scanResult.score .. ")"
								elseif scanResult.score >= 2 then
									scriptRisk = "MEDIUM"
									scriptReason = "vulnerabilities found (score: " .. scanResult.score .. ")"
								else
									scriptReason = "minor issues (score: " .. scanResult.score .. ")"
								end
								local lineCount = 1
								for _ in source:gmatch("\n") do lineCount += 1 end
								table.insert(scriptMeta, "lines: " .. lineCount .. " | size: " .. #source .. "b")
								local shown = 0
								for _, v in scanResult.vulnerabilities do
									if shown >= 6 then break end
									table.insert(scriptVulns, v)
									vulnCount += 1
									shown += 1
								end
								if #scanResult.vulnerabilities > 6 then
									table.insert(scriptMeta, "+" .. (#scanResult.vulnerabilities - 6) .. " more findings")
								end
								for secretMatch in source:gmatch('["\'][%w_-]+_[%w_-]+_[%w_-]+["\']=') do
									table.insert(scriptMeta, "secret: " .. secretMatch:sub(1, 30) .. "...")
									vulnCount += 1
								end
								for gMatch in source:gmatch("_G%.[%w_]+%s*=") do
									table.insert(scriptMeta, "global: " .. gMatch)
								end
								if source:find("Chatted:Connect") then
									table.insert(scriptMeta, "listens: player chat events")
									for cmdMatch in source:gmatch('%["/(%w+)"%]') do
										table.insert(scriptMeta, "command: /" .. cmdMatch)
									end
								end
							else
								table.insert(scriptMeta, "source: not readable (protected)")
							end
							if scriptRisk == "HIGH" then highCount += 1 end
							table.insert(scriptEntries, {
								name = desc.Name,
								className = desc.ClassName,
								path = safeGetFullName(desc),
								risk = scriptRisk,
								reason = scriptReason,
								metadata = scriptMeta,
								vulns = scriptVulns,
							})
						end
					end
				end
			end
		end
		task.wait()

		statusLabel.Text = "Scanning workspace..."
		local ok, wsDescendants = pcall(function() return workspace:GetDescendants() end)
		if ok then
			for _, desc in wsDescendants do
				if desc:IsA("BasePart") and not desc:IsA("Terrain") and not desc:IsA("SpawnLocation") then
					local partMeta = {}
					local partRisk = "LOW"
					local partReason = "static part"
					local attrsOk, attrs = pcall(function() return desc:GetAttributes() end)
					if attrsOk then
						for attrName, attrValue in attrs do
							table.insert(partMeta, "attr: " .. attrName .. " = " .. tostring(attrValue))
						end
					end
					local hasScripts = false
					for _, child in desc:GetChildren() do
						if child:IsA("Script") or child:IsA("LocalScript") then
							hasScripts = true
							table.insert(partMeta, "script: " .. child.Name)
						end
					end
					if hasScripts then
						partRisk = "MEDIUM"
						partReason = "part with attached scripts (touch-triggered?)"
					end
					if not desc.Anchored then
						table.insert(partMeta, "physics: unanchored (can be pushed)")
					end
					local nameLower = string.lower(desc.Name)
					if nameLower:find("lava") or nameLower:find("kill") or nameLower:find("death") then
						partRisk = "MEDIUM"
						partReason = "kill/damage part"
						table.insert(partMeta, "type: kill brick")
					elseif nameLower:find("coin") or nameLower:find("reward") or nameLower:find("give") then
						partRisk = "MEDIUM"
						partReason = "reward-giving part"
						table.insert(partMeta, "type: reward giver")
					elseif nameLower:find("speed") or nameLower:find("boost") then
						partRisk = "MEDIUM"
						partReason = "speed/boost part"
						table.insert(partMeta, "type: speed modifier")
					elseif nameLower:find("terminal") or nameLower:find("data") then
						partRisk = "MEDIUM"
						partReason = "data terminal (info leak?)"
						table.insert(partMeta, "type: data terminal")
					end
					if #partMeta > 0 or partRisk ~= "LOW" then
						table.insert(partEntries, {
							name = desc.Name,
							className = "BasePart",
							path = safeGetFullName(desc),
							risk = partRisk,
							reason = partReason,
							metadata = partMeta,
						})
					end
				end
			end
		end
		task.wait()

		statusLabel.Text = "Scanning players..."
		for _, plr in Players:GetPlayers() do
			if plr ~= LocalPlayer then
				playersFound += 1
				local plrMeta = {}
				table.insert(plrMeta, "userId: " .. plr.UserId)
				table.insert(plrMeta, "accountAge: " .. plr.AccountAge .. " days")
				if plr.Character then
					local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
					if humanoid then
						table.insert(plrMeta, "health: " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth))
						table.insert(plrMeta, "speed: " .. humanoid.WalkSpeed)
					end
					local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
					if hrp then
						local pos = hrp.Position
						table.insert(plrMeta, "position: " .. math.floor(pos.X) .. ", " .. math.floor(pos.Y) .. ", " .. math.floor(pos.Z))
					end
					for _, tool in plr.Character:GetChildren() do
						if tool:IsA("Tool") then
							table.insert(plrMeta, "tool: " .. tool.Name)
						end
					end
				end
				table.insert(playerEntries, {
					name = plr.Name,
					className = "Player",
					path = safeGetFullName(plr),
					risk = "MEDIUM",
					reason = "player target (can be affected by remotes)",
					metadata = plrMeta,
				})
			end
		end

		statusLabel.Text = "Scanning globals..."
		local gMeta = {}
		for key, value in _G do
			if type(key) == "string" and key ~= "_G" and key ~= "game" and key ~= "workspace" and key ~= "script" then
				table.insert(gMeta, "_" .. key .. " = " .. type(value))
			end
		end
		if #gMeta > 0 then
			table.insert(gMetaEntries, {
				name = "_G (globals)",
				className = "Table",
				path = "_G",
				risk = "HIGH",
				reason = "leaked globals detected (data exposure via _G)",
				metadata = gMeta,
			})
			vulnCount += #gMeta
			highCount += 1
		end

		clearResults()

		for _, entry in ipairs(remoteEntries) do
			createDetailedEntry(entry.name, entry.className, entry.path, entry.risk, entry.reason, entry.metadata)
		end
		for _, entry in ipairs(scriptEntries) do
			createDetailedEntry(entry.name, entry.className, entry.path, entry.risk, entry.reason, entry.metadata, entry.vulns)
		end
		for _, entry in ipairs(partEntries) do
			createDetailedEntry(entry.name, entry.className, entry.path, entry.risk, entry.reason, entry.metadata)
		end
		for _, entry in ipairs(playerEntries) do
			createDetailedEntry(entry.name, entry.className, entry.path, entry.risk, entry.reason, entry.metadata)
		end
		for _, entry in ipairs(gMetaEntries) do
			createDetailedEntry(entry.name, entry.className, entry.path, entry.risk, entry.reason, entry.metadata)
		end

		updateCanvasSize(resultsList)

		statusLabel.Text = string.format(
			"Done \226\128\148 %d remotes \194\183 %d scripts \194\183 %d players \194\183 %d HIGH \194\183 %d findings",
			remotesFound, scriptsFound, playersFound, highCount, vulnCount
		)
		statusLabel.TextColor3 = if highCount > 0 then COLOR.HIGH else COLOR.LOW
		cleanupScan()
	end)

	if not success then
		warn("Scanner error: " .. tostring(err))
		cleanupScan()
		statusLabel.Text = "Scan failed"
		statusLabel.TextColor3 = COLOR.HIGH
	end
end

if scanBtn then
	scanBtn.MouseButton1Click:Connect(runScan)
end

