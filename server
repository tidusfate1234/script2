local function scanScriptSource(source)
	local found = {}
	local score = 0
	local seen = {}
	for _, vp in VULN_PATTERNS do
		if source:find(vp.pattern) and not seen[vp.pattern] then
			seen[vp.pattern] = true
			table.insert(found, {risk = vp.risk, reason = vp.reason})
			if vp.risk == "HIGH" then
				score += 3
			elseif vp.risk == "MEDIUM" then
				score += 1
			end
		end
	end
	return {vulnerabilities = found, score = score}
end

local function assessRemoteRisk(inst)
	local name = string.lower(inst.Name)
	local className = inst.ClassName
	local risk = "LOW"
	local reason = "standard remote"
	local metadata = {}
	if className == "RemoteFunction" then
		risk = "MEDIUM"
		reason = "RemoteFunction (returns data to caller)"
		table.insert(metadata, "type: returns data on invoke")
	end
	if inst.Parent and inst.Parent:IsA("ReplicatedStorage") then
		risk = "MEDIUM"
		reason = "root-level in ReplicatedStorage (no folder protection)"
		table.insert(metadata, "parent: ReplicatedStorage (root)")
	elseif inst.Parent and inst.Parent:IsA("Folder") then
		table.insert(metadata, "parent: " .. inst.Parent.Name .. " (folder)")
	else
		table.insert(metadata, "parent: " .. (inst.Parent and inst.Parent.Name or "unknown"))
	end
	if name:match("^event%d*$") or name:match("^remote%d*$") or name:match("^re%d*$") or name == "event" or name == "remote" then
		risk = "MEDIUM"
		reason = "generic/auto-generated name (likely unprotected)"
		table.insert(metadata, "naming: generic pattern detected")
	end
	local childCount = 0
	for _, _ in inst:GetChildren() do
		childCount += 1
	end
	if childCount > 0 then
		table.insert(metadata, "children: " .. childCount .. " (has attached logic)")
	end
	for _, kw in HIGH_KEYWORDS do
		if name:find(kw) then
			risk = "HIGH"
			reason = "HIGH keyword: \"" .. kw .. "\" (likely exploitable)"
			table.insert(metadata, "keyword: \"" .. kw .. "\" -> potential RCE/admin bypass")
			break
		end
	end
	if risk ~= "HIGH" then
		for _, kw in MEDIUM_KEYWORDS do
			if name:find(kw) then
				if risk == "LOW" then risk = "MEDIUM" end
				reason = "keyword: \"" .. kw .. "\" (manipulates game state)"
				table.insert(metadata, "keyword: \"" .. kw .. "\" -> state manipulation possible")
				break
			end
		end
	end
	if name:find("execute") or name:find("command") or name:find("exec") then
		risk = "HIGH"
		reason = "code execution remote (CRITICAL)"
		table.insert(metadata, "WARNING: CAN RUN ARBITRARY CODE ON SERVER")
	elseif name:find("admin") then
		risk = "HIGH"
		reason = "admin remote (no auth expected)"
		table.insert(metadata, "WARNING: NO ADMIN VERIFICATION EXPECTED")
	elseif name:find("kill") then
		risk = "HIGH"
		reason = "kill remote (no permission check)"
		table.insert(metadata, "WARNING: CAN KILL ANY PLAYER")
	elseif name:find("teleport") then
		risk = "HIGH"
		reason = "teleport remote (no auth check)"
		table.insert(metadata, "WARNING: CAN TELEPORT ANY PLAYER")
	elseif name:find("give") and (name:find("coin") or name:find("reward") or name:find("item")) then
		risk = "HIGH"
		reason = "give remote (no amount validation)"
		table.insert(metadata, "WARNING: NO AMOUNT/OWNERSHIP VALIDATION")
	elseif name:find("set") and (name:find("speed") or name:find("walk")) then
		risk = "HIGH"
		reason = "speed remote (no cap/permission check)"
		table.insert(metadata, "WARNING: NO SPEED CAP OR PERMISSION CHECK")
	elseif name:find("data") or name:find("fetch") or name:find("get") then
		if className == "RemoteFunction" then
			risk = "HIGH"
			reason = "data-returning remote (leaks server data)"
			table.insert(metadata, "WARNING: RETURNS SERVER-SIDE DATA TO CALLER")
		end
	elseif name:find("trade") then
		risk = "MEDIUM"
		reason = "trade remote (no ownership verification)"
		table.insert(metadata, "WARNING: NO ITEM OWNERSHIP VERIFICATION")
	elseif name:find("leaderboard") or name:find("score") or name:find("update") then
		risk = "MEDIUM"
		reason = "score update remote (trusts client value)"
		table.insert(metadata, "WARNING: CLIENT CONTROLS OWN SCORE")
	end
	return {risk = risk, reason = reason, metadata = metadata}
end

local function clearResults()
	if not resultsList then return end
	for _, child in resultsList:GetChildren() do
		if child:IsA("Frame") then child:Destroy() end
	end
end

local SCAN_TARGETS = {
	game:GetService("ReplicatedStorage"),
	game:GetService("ReplicatedFirst"),
	game:GetService("StarterGui"),
	game:GetService("StarterPlayer"),
	game:GetService("StarterPack"),
	workspace,
}

local function safeGetFullName(instance)
	local ok, result = pcall(function() return instance:GetFullName() end)
	if ok then return result else return "(destroyed)" end
end

local function createDetailedEntry(name, className, path, riskLevel, reason, metadata, vulns)
	if not resultsList then return end
	local riskColor = COLOR[riskLevel] or COLOR.LOW
	local metaLines = metadata or {}
	local vulnList = vulns or {}
	local extraLines = #metaLines + #vulnList
	local entryHeight = 54 + math.clamp(extraLines, 0, 6) * 14
	local entry = Instance.new("Frame")
	entry.Name = name
	entry.Size = UDim2.new(1, 0, 0, entryHeight)
	entry.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
	entry.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = entry
	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 8, 0, 8)
	dot.Position = UDim2.new(0, 8, 0, 6)
	dot.BackgroundColor3 = riskColor
	dot.BorderSizePixel = 0
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
	dot.Parent = entry
	local classPrefix = "[?]  "
	if className == "RemoteEvent" then classPrefix = "[RE] "
	elseif className == "RemoteFunction" then classPrefix = "[RF] "
	elseif className == "Player" then classPrefix = "[P]  "
	elseif className == "LocalScript" then classPrefix = "[LS] "
	elseif className == "ModuleScript" then classPrefix = "[MS] "
	elseif className == "Script" then classPrefix = "[S]  "
	elseif className == "BasePart" then classPrefix = "[BP] "
	elseif className == "Table" then classPrefix = "[T]  "
