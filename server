local function clampPosition()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local viewportSize = camera.ViewportSize
	local halfW = viewportSize.X / 2
	local halfH = viewportSize.Y / 2
	local offsetX = executor.Position.X.Offset
	local offsetY = executor.Position.Y.Offset
	local minVisible = 30
	local minX = -(halfW - minVisible)
	local maxX = halfW - minVisible
	local minY = -(halfH - minVisible)
	local maxY = halfH - minVisible
	offsetX = math.clamp(offsetX, minX, maxX)
	offsetY = math.clamp(offsetY, minY, maxY)
	executor.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)
