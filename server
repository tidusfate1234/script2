local CLIENT_PATTERNS = {
	"LocalPlayer", "CurrentCamera", "UserInputService", "RenderStepped",
	"PlayerGui", "GetMouse", "ContextActionService", "InputBegan",
	"InputEnded", "StarterPlayerScripts", "StarterCharacterScripts",
	"LocalTransparencyModifier", "CameraMode", "MouseIcon",
}

local SERVER_PATTERNS = {
	"FireAllClients", "FireClient(", "DataStoreService",
	"OnServerEvent", "OnServerInvoke", "ServerScriptService",
}

local function detectContext(code)
	local hasClient = false
	local hasServer = false
	for _, pattern in CLIENT_PATTERNS do
		if code:find(pattern) then
			hasClient = true
			break
		end
	end
	for _, pattern in SERVER_PATTERNS do
		if code:find(pattern) then
			hasServer = true
			break
		end
	end
	if hasClient and hasServer then
		return "BOTH"
	elseif hasClient then
		return "CLIENT"
	else
		return "SERVER"
	end
end

local function executeOnClient(code)
	local outputLines = {}
	local originalPrint = print
	local originalWarn = warn
	local function capturePrint(...)
		local parts = {}
		for i = 1, select("#", ...) do
			parts[i] = tostring(select(i, ...))
		end
		table.insert(outputLines, { type = "print", text = table.concat(parts, "\t") })
		originalPrint(...)
	end
	local function captureWarn(...)
		local parts = {}
		for i = 1, select("#", ...) do
			parts[i] = tostring(select(i, ...))
		end
		table.insert(outputLines, { type = "warn", text = table.concat(parts, "\t") })
		originalWarn(...)
	end
	local vm = loadstringModule and require(loadstringModule)
	if not vm then
		table.insert(outputLines, { type = "error", text = "VM pipeline not available" })
		return "ERROR", outputLines
	end
	local env = vm.buildEnv({
		print = capturePrint,
		warn = captureWarn,
		player = LocalPlayer,
		LocalPlayer = LocalPlayer,
		character = LocalPlayer.Character,
		humanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"),
	})
	local success, gev = pcall(function() return getgenv() end)
	if success and gev then
		for k, v in pairs(gev) do
			if env[k] == nil then
				env[k] = v
			end
		end
	end
	local func, err = vm.loadstring(code, env)
	if not func then
		table.insert(outputLines, { type = "error", text = tostring(err) })
		return "ERROR", outputLines
	end
	local ok, runErr = pcall(func)
	if ok then
		return "SUCCESS", outputLines
	else
		table.insert(outputLines, { type = "error", text = tostring(runErr) })
		return "ERROR", outputLines
	end
end

local function handleOutput(status, outputLines, source)
	if status == "SUCCESS" then
		setStatus(source .. " execution completed", COLOR.LOW)
		setIndicator(COLOR.LOW)
		hideError()
	elseif status == "ERROR" then
		local errorText = "Unknown " .. source:lower() .. " error"
		if type(outputLines) == "table" then
			for _, entry in ipairs(outputLines) do
				if entry.type == "error" then
					errorText = entry.text
					break
				end
			end
		end
		setStatus(source .. " execution failed", COLOR.HIGH)
		setIndicator(COLOR.HIGH)
		showError(errorText)
	end
	if type(outputLines) == "table" then
		for _, entry in ipairs(outputLines) do
			if entry.type == "print" then
				print("[Lunar " .. source .. "]", entry.text)
			elseif entry.type == "warn" then
				warn("[Lunar " .. source .. "]", entry.text)
			elseif entry.type == "error" then
				warn("[Lunar Error " .. source .. "]", entry.text)
			end
		end
	end
end

