    local function scanActiveNpcs()
        local activeNpcs = workspace:FindFirstChild("ActiveNPCs")
        if not activeNpcs then return end
        for _, npc in ipairs(activeNpcs:GetChildren()) do
            if npc:IsA("Model") then
                local idVal = npc:FindFirstChild("NpcId") or npc:FindFirstChild("ID")
                if idVal and idVal:IsA("StringValue") and isValidNpcId(idVal.Value) then
                    stolenNpcIds[idVal.Value] = true
                elseif isValidNpcId(npc.Name) then
                    stolenNpcIds[npc.Name] = true
                end
            end
        end
    end

    local function sniffNpcIds()
        if sniffersActive then return end
        sniffersActive = true
        local npcBegSync = events:FindFirstChild("NPCBeggedSync")
        if npcBegSync and npcBegSync:IsA("RemoteFunction") then
            local conns = getconnections(npcBegSync.OnClientInvoke)
            if conns and #conns > 0 then
                for _, conn in ipairs(conns) do
                    local old = conn.Function
                    conn.Function = function(...)
                        local args = {...}
                        if isValidNpcId(args[1]) then stolenNpcIds[args[1]] = true end
                        return old(...)
                    end
                end
            end
        end
        local secondChance = events:FindFirstChild("SecondChancePrompt")
        if secondChance then
            local conns = getconnections(secondChance.OnClientEvent)
            if conns and #conns > 0 then
                for _, conn in ipairs(conns) do
                    local old = conn.Function
                    conn.Function = function(...)
                        local args = {...}
                        if type(args[1]) == "table" and isValidNpcId(args[1].NpcId) then
                            stolenNpcIds[args[1].NpcId] = true
                        end
                        return old(...)
                    end
                end
            end
        end
    end

    local function massBeg(count)
        local now = os.clock()
        if now - lastBegTime < BEG_COOLDOWN then return 0 end
        local npcBeg = events:FindFirstChild("NPCBeggedSync")
        if not npcBeg then return 0 end
        local allIds = {}
        for id in pairs(stolenNpcIds) do allIds[id] = true end
        for id in pairs(generatedNpcIds) do allIds[id] = true end
        local idList = {}
        for id in pairs(allIds) do table.insert(idList, id) end
        local maxBegs = math.min(count or 150, #idList)
        if maxBegs < 1 then return 0 end
        local successes = 0
        for i = 1, maxBegs do
            if not isValidNpcId(idList[i]) then continue end
            local ok = pcall(function()
                if npcBeg:IsA("RemoteFunction") then
                    npcBeg:InvokeServer(idList[i])
                else
                    npcBeg:FireServer(idList[i])
                end
            end)
            if ok then successes = successes + 1 end
            if i % 50 == 0 then task.wait(math.random(8, 15) / 100) end
        end
        lastBegTime = os.clock()
        begCount = begCount + successes
        return successes
    end

