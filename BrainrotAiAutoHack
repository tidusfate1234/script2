    local function fillTextBox(box, value)
        if not box or not box:IsA("TextBox") then return false end
        return pcall(function()
            box.TextEditable = true
            box.Visible = true
            box.Text = tostring(value)
            for _, conn in ipairs(getconnections(box.FocusLost)) do
                pcall(conn.Function, true)
            end
        end)
    end

