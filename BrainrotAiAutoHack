    local function generateNpcId()
        local parts = table.create(7)
        for i = 1, 7 do
            local idx = math.random(1, NPC_ID_LENGTH)
            parts[i] = NPC_ID_CHARS:sub(idx, idx)
        end
        return table.concat(parts)
    end

    for _ = 1, 500 do
        generatedNpcIds[generateNpcId()] = true
