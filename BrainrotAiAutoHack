    local function countKeys(tbl)
        local n = 0
        for _ in pairs(tbl) do n = n + 1 end
        return n
    end

    local function isValidNpcId(id)
        if type(id) ~= "string" then return false end
        if #id ~= 7 then return false end
        if not id:match("^[%w]+$") then return false end
        return true
    end

    local function cleanupIdTables()
        local now = os.clock()
        if now - lastIdCleanup < 60 then return end
        lastIdCleanup = now
        local genCount = countKeys(generatedNpcIds)
        if genCount > ID_CLEANUP_MAX then
            local sorted = {}
            for id in pairs(generatedNpcIds) do table.insert(sorted, id) end
            table.sort(sorted)
            generatedNpcIds = {}
            for i = 1, ID_CLEANUP_MAX do
                if sorted[i] then generatedNpcIds[sorted[i]] = true end
            end
        end
        local stolenCount = countKeys(stolenNpcIds)
        if stolenCount > ID_CLEANUP_MAX then
            local sorted = {}
            for id in pairs(stolenNpcIds) do table.insert(sorted, id) end
            table.sort(sorted)
            stolenNpcIds = {}
            for i = 1, ID_CLEANUP_MAX do
                if sorted[i] then stolenNpcIds[sorted[i]] = true end
            end
        end
    end

